{
    "name": "szepeviktor/chouby-decade",
    "description": "Composer plugin that resolves the Polylang Pro dist URL using a license key from the environment.",
    "type": "composer-plugin",
    "license": "MIT",
    "homepage": "https://github.com/szepeviktor/Chouby-decade",
    "require": {
        "php": ">=7.4",
        "composer-plugin-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SzepeViktor\\ChoubyDecade\\": "src/"
        }
    },
    "extra": {
        "class": "SzepeViktor\\ChoubyDecade\\Plugin",
        "plugin-modifies-downloads": true
    }
}
